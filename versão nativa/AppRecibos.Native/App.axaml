            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.actionDelete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- CheckBox Estilo Tailwind React (15x15, cantos 2.5px, borda sutil, azul sólido) -->
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*" Background="Transparent">
                        <Border x:Name="NormalRectangle"
                                Width="15" Height="15"
                                CornerRadius="2.5"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CheckBoxCheckBackgroundStrokeUnchecked}"
                                Background="{DynamicResource CheckBoxCheckBackgroundFillUnchecked}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Path x:Name="CheckGlyph"
                                  Data="M3.5 7.5L6 10L11.5 4.5"
                                  Stroke="White"
                                  StrokeThickness="1.75"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Stretch="Uniform"
                                  Width="9" Height="9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="False"/>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
        </Style>

        <!-- ComboBox Estilo Tailwind React (8px cantos, fundo sutil) -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <!-- ComboBoxItem Estilo e Hover de Alto Contraste -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>

        <!-- DataGrid Cabeçalhos, Linhas e Células 1:1 ao React -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,6,4,6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>
        <Style Selector="DataGridColumnHeader Path#SortIcon">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#EFF6FF"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#DBEAFE"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#F8FAFC"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- DataGrid Sort Icon MinWidth Overridden to 0 to prevent text clipping -->
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

        <!-- DataGrid Brushes Globais para Linha Selecionada e Hover 1:1 ao React -->
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="DataGridRowHoveredBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="#475569" />
        <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="Transparent" />

        <!-- CheckBox Brushes Globais 1:1 ao React -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="White" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#CBD5E1" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#94A3B8" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#2563EB" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#2563EB" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#1D4ED8" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#1D4ED8" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="White" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="White" />

        <SolidColorBrush x:Key="SlateDarkBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="SlateHeaderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="SlateBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SlateBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SlateTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="SlateMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="EmeraldBrush" Color="#059669" />
        <SolidColorBrush x:Key="EmeraldLightBrush" Color="#D1FAE5" />
        <SolidColorBrush x:Key="AmberBrush" Color="#D97706" />
        <SolidColorBrush x:Key="AmberLightBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="BluePrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BlueLightBrush" Color="#EFF6FF" />
    </Application.Resources>
</Application>
