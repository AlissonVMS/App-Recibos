<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppRecibos.Native.ViewModels"
        x:Class="AppRecibos.Native.Views.PaymentDialog"
        x:DataType="vm:PaymentDialogViewModel"
        Title="Registrar Novo Pagamento"
        Width="520" Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Cabeçalho Slate 900 Estilo React -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Registrar Novo Pagamento" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Dados financeiros da parcela vinculados ao cadastro do cedente" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Classes="ghost" Padding="4" ToolTip.Tip="Fechar" Cursor="Hand">
                    <Path Data="M18 6L6 18 M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                          Stretch="Uniform" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulário Central -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="20">
                <!-- Beneficiário / Cedente -->
                <StackPanel Spacing="6">
                    <TextBlock Text="BENEFICIÁRIO / CEDENTE *" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <ComboBox ItemsSource="{Binding Beneficiarios}"
                              SelectedItem="{Binding SelectedBeneficiario}"
                              HorizontalAlignment="Stretch"
                              DisplayMemberBinding="{Binding Nome}"/>
                </StackPanel>

                <!-- Linha: Valor e Data -->
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="VALOR DO PAGAMENTO *" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <NumericUpDown Value="{Binding Valor}" Minimum="0" FormatString="C2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="DATA DO PAGAMENTO *" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <DatePicker SelectedDate="{Binding DataPrevista}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Linha: Forma de Pagamento -->
                <StackPanel Spacing="6">
                    <TextBlock Text="FORMA DE PAGAMENTO *" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Data="M4 4h6v6H4V4zm10 10h6v6h-6v-6zm0-10h6v6h-6V4zM4 14h6v6H4v-6z"
                                  Stroke="#2563EB" StrokeThickness="1.5" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="PIX (Transferência Instantânea)" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Box Estilizado: Dados Cadastrados do PIX -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="12">
                        <!-- Cabeçalho do Box -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Data="M3 3h7v7H3V3zm11 11h7v7h-7v-7zm0-11h7v7h-7V3zM3 14h7v7H3v-7z"
                                  Stroke="#059669" StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Dados Cadastrados do PIX" FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                        </StackPanel>

                        <!-- Informações em Grid -->
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="TIPO DE CHAVE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="CPF" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="CHAVE PIX" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ChavePix}" FontSize="12" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#0F172A"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,8,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="BANCO RECEBEDOR" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Banco}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Alerta Informativo Estilo React -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Data="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
                              Stroke="#2563EB" StrokeThickness="1.5" Stretch="Uniform" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="Os dados bancários e identificadores refletem o cadastro central do cedente. Para alterar banco ou chave PIX, utilize a aba Gestão de Contrato ou Edição do Cedente."
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Checkbox de Quitação Civil -->
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <CheckBox IsChecked="{Binding IsPago}" Content="Parcela Efetivamente Paga (Quitação Civil)" FontWeight="SemiBold" Foreground="#065F46"/>
                </Border>

                <!-- Mensagem de Erro (se houver) -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage.Length}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé de Ações Estilo React -->
        <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding SaveCommand}"
                        Padding="18,8"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8"
                              Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Salvar Pagamento" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"
                        Classes="ghost"
                        Padding="14,8"
                        Cursor="Hand">
                    <TextBlock Text="Cancelar" FontSize="12" FontWeight="Medium" Foreground="#475569"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
