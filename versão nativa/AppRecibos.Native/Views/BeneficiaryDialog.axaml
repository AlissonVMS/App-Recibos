<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppRecibos.Native.ViewModels"
        x:Class="AppRecibos.Native.Views.BeneficiaryDialog"
        x:DataType="vm:BeneficiaryDialogViewModel"
        Title="Editar Dados do Cedente / Beneficiário"
        Width="540" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. Header Dark Slate -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#1E293B">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Editar Dados do Cedente / Beneficiário" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Nome}" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CancelCommand}" Classes="ghost" Padding="6" CornerRadius="6" Cursor="Hand">
                    <Path Data="M18 6L6 18 M6 6l12 12" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Corpo do Formulário com Scroll -->
        <ScrollViewer Grid.Row="1" Padding="20,16">
            <StackPanel Spacing="16">
                <!-- BLOCO BLOQUEADO: Dados Contratuais e Financeiros -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Path Data="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z M7 11V7a5 5 0 0 1 10 0v4"
                                      Stroke="#64748B" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12"/>
                                <TextBlock Text="DADOS CONTRATUAIS &amp; FINANCEIROS (BLOQUEADOS)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                            <!-- Contrato -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,4,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Contrato" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ContratoTotalFormatado}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Pago -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="2,0,2,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Total Pago" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalPagoFormatado}" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                                </StackPanel>
                            </Border>

                            <!-- Saldo Devedor -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Saldo Devedor" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SaldoDevedorFormatado}" FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <Path Data="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01"
                                  Stroke="#94A3B8" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12"/>
                            <TextBlock Text="Calculado automaticamente. Alterações contratuais em 'Gestão do Contrato'." FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- IDENTIFICAÇÃO PESSOAL (BLOQUEADA) -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="NOME COMPLETO" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="Bloqueado" FontSize="10" Foreground="#94A3B8"/>
                        </Grid>
                        <TextBox Text="{Binding Nome}" IsReadOnly="True" Background="#F1F5F9" Foreground="#475569" CornerRadius="8" Padding="10,8" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="CPF" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="Bloqueado" FontSize="10" Foreground="#94A3B8"/>
                        </Grid>
                        <TextBox Text="{Binding Cpf}" IsReadOnly="True" FontFamily="Consolas, monospace" Background="#F1F5F9" Foreground="#475569" CornerRadius="8" Padding="10,8" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- CAMPO EDITÁVEL: Cidade / UF -->
                <StackPanel Spacing="4">
                    <TextBlock Text="CIDADE / UF" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <TextBox Text="{Binding CidadeUf}" CornerRadius="8" Padding="10,8" Background="White" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- SEÇÃO DADOS BANCÁRIOS & CHAVE PIX -->
                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18 M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2 M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"
                                  Stroke="#2563EB" StrokeThickness="1.5" Stretch="Uniform" Width="14" Height="14"/>
                            <TextBlock Text="DADOS BANCÁRIOS &amp; CHAVE PIX" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                        </StackPanel>

                        <!-- Banco -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="INSTITUIÇÃO FINANCEIRA (BANCO)" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBox Text="{Binding Banco}" CornerRadius="8" Padding="10,8" Background="White" BorderBrush="#CBD5E1"
                                     Watermark="Ex: 104 - Caixa Econômica Federal ou Nubank S.A."/>
                        </StackPanel>

                        <!-- Agência, Conta, Tipo de Conta -->
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                                <TextBlock Text="AGÊNCIA" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                <TextBox Text="{Binding Agencia}" FontFamily="Consolas, monospace" CornerRadius="8" Padding="10,8" Background="White" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="2,0,2,0" Spacing="4">
                                <TextBlock Text="CONTA" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                <TextBox Text="{Binding Conta}" FontFamily="Consolas, monospace" CornerRadius="8" Padding="10,8" Background="White" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0,0,0" Spacing="4">
                                <TextBlock Text="TIPO CONTA" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                <ComboBox ItemsSource="{Binding TipoContaOptions}" SelectedItem="{Binding TipoConta}"
                                          HorizontalAlignment="Stretch" CornerRadius="8" Padding="10,6" Background="White" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tipo de Chave & Chave PIX -->
                        <Grid ColumnDefinitions="110,*">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                <TextBlock Text="TIPO CHAVE" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                <ComboBox ItemsSource="{Binding TipoChavePixOptions}" SelectedItem="{Binding TipoChavePix}"
                                          HorizontalAlignment="Stretch" CornerRadius="8" Padding="10,6" Background="White" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                <TextBlock Text="CHAVE PIX" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                <TextBox Text="{Binding ChavePix}" FontFamily="Consolas, monospace" CornerRadius="8" Padding="10,8" Background="White" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mensagem de Erro (se houver) -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer com Botões Cancelar e Salvar Alterações -->
        <Border Grid.Row="2" Background="White" Padding="20,14" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Command="{Binding CancelCommand}" Classes="secondary" Content="Cancelar"/>
                <Button Command="{Binding SaveCommand}" Classes="primary">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8"
                              Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13"/>
                        <TextBlock Text="Salvar Alterações" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
