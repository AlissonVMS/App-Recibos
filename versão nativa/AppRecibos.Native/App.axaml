<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AppRecibos.Native.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Regra Global de Cursores para Elementos Interativos -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Variantes Globais de Botões (Idênticas ao Tailwind da Opção 1) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.emerald">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.emerald /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.emerald:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#047857"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.emerald:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#065F46"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.amber">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.amber /template/ ContentPresenter#PART_ContentPresenter">
